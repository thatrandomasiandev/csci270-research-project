+namespace {
+// Map [fileOff, fileOff+dataLen) read-only private; returns pointer to data (not page base).
+char* mmapFileSlice(const string &path, off_t fileOff, size_t dataLen,
+                    char **baseOut, size_t *lenOut, int advice)
+{
+    long pageL = sysconf(_SC_PAGESIZE);
+    if (pageL <= 0) pageL = 4096;
+    size_t page = (size_t) pageL;
+    off_t pageOff = fileOff & ~(off_t)(page - 1);
+    size_t delta = (size_t)(fileOff - pageOff);
+    size_t mapLen = dataLen + delta;
+    int fd = open(path.c_str(), O_RDONLY);
+    if (fd < 0) return NULL;
+    char *base = (char*) mmap(NULL, mapLen, PROT_READ, MAP_PRIVATE, fd, pageOff);
+    int err = errno;
+    close(fd);
+    if (base == MAP_FAILED) {
+        errno = err;
+        return NULL;
+    }
+    if (advice >= 0) {
+        madvise(base, mapLen, advice);
+    }
+    *baseOut = base;
+    *lenOut = mapLen;
+    return base + delta;
+}
+
+// Anonymous region with L-byte head/tail padding; Genome file mapped at G.
+bool mmapGenomeWithPadding(const string &path, uint64 nGenome, uint L, uint8 fillSym,
+                           char **G1out, char **Gout,
+                           char **baseOut, size_t *lenOut)
+{
+    long pageL = sysconf(_SC_PAGESIZE);
+    if (pageL <= 0) pageL = 4096;
+    size_t page = (size_t) pageL;
+    size_t lead = ((size_t)L + page - 1) / page * page; // >= L, page-aligned
+    size_t total = lead + (size_t)nGenome + (size_t)L;
+    char *base = (char*) mmap(NULL, total, PROT_READ | PROT_WRITE,
+                              MAP_PRIVATE | MAP_ANONYMOUS, -1, 0);
+    if (base == MAP_FAILED) return false;
+
+    int fd = open(path.c_str(), O_RDONLY);
+    if (fd < 0) {
+        munmap(base, total);
+        return false;
+    }
+    void *mapped = mmap(base + lead, (size_t)nGenome, PROT_READ,
+                        MAP_PRIVATE | MAP_FIXED, fd, 0);
+    int err = errno;
+    close(fd);
+    if (mapped == MAP_FAILED) {
+        munmap(base, total);
+        errno = err;
+        return false;
+    }
+    madvise(base + lead, (size_t)nGenome, MADV_SEQUENTIAL);
+#ifdef MADV_WILLNEED
+    madvise(base + lead, (size_t)nGenome, MADV_WILLNEED);
+#endif
+    char *G1 = base + lead - L;
+    char *G = G1 + L;
+    memset(G1, fillSym, L);
+    memset(G + nGenome, fillSym, L);
+    *G1out = G1;
+    *Gout = G;
+    *baseOut = base;
+    *lenOut = total;
+    return true;
+}
