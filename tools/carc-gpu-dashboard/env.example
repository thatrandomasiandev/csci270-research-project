# Copy to .env in this directory (optional). run.sh sources it automatically.
# Live Slurm queries use the remote $USER from SSH; CARC_NETID is display-only.

CARC_SSH_HOST=discovery
# CARC_NETID=YOUR_NETID

CARC_DASH_HOST=127.0.0.1
CARC_DASH_PORT=8767
CARC_DASH_TTL=25
CARC_DASH_HISTORY_HOURS=48
CARC_DASH_PARTITIONS=gpu,debug

# Optional: offline UI smoke test only (not the live dashboard):
# CARC_DASH_DEMO=1
