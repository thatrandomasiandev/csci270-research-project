#!/bin/bash
# Diverse-genome exactness. One proteome per array task. Non-exclusive.
# Memory and time are set at submit: 48G/12h when the NCBI protein count
# is above 8000, otherwise 16G/6h. The array cap is set at submit so the
# small and large cohorts together stay at or under 20 tasks.
#SBATCH --job-name=tare_div
#SBATCH --account=biyik_1165
#SBATCH --partition=main
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=8
#SBATCH --mem=16G
#SBATCH --time=06:00:00
#SBATCH --output=/project2/biyik_1165/jjt_373/csci270-star/diverse_genomes/logs/%x-%A_%a.out
#SBATCH --error=/project2/biyik_1165/jjt_373/csci270-star/diverse_genomes/logs/%x-%A_%a.err

set -euo pipefail

ROOT="${ACTS_CODE_ROOT:-/project2/biyik_1165/jjt_373/csci270-star/diverse_genomes/pipeline}"
OLD_HMM="${ACTS_PFAM_OLD:-/project2/biyik_1165/jjt_373/csci270-star/reference_reannot/data/pfam38.1/Pfam-A.hmm.gz}"
NEW_HMM="${ACTS_PFAM_NEW:-/project2/biyik_1165/jjt_373/csci270-star/pipeline/data/hmmer/Pfam-A.hmm.gz}"
export ACTS_GENOMES="${ACTS_GENOMES:-/project2/biyik_1165/jjt_373/csci270-star/diverse_genomes/proteomes}"
export ACTS_OUT_DIR="${ACTS_OUT_DIR:-/project2/biyik_1165/jjt_373/csci270-star/diverse_genomes/results}"
if [[ -z "${ACTS_COHORT:-}" || -z "${ACTS_SIZE:-}" ]]; then
  echo "STOP: ACTS_COHORT and ACTS_SIZE are required" >&2
  exit 2
fi
# Scratch: node-local /tmp (tmpfs on these nodes) when it has room, else /scratch1.
# The floor matches pipeline/jobs/headline_carc_pilot.job.
TMP_FREE_KB="$(df -Pk /tmp | awk 'NR==2{print $4}')"
if [[ "${TMP_FREE_KB}" -ge $((40*1024*1024)) ]]; then
  SCRATCH="/tmp/tare_div_${SLURM_JOB_ID}"
else
  SCRATCH="/scratch1/${USER}/tare_div_${SLURM_JOB_ID}"
  echo "NOTE: /tmp has ${TMP_FREE_KB} KB free; using ${SCRATCH}"
fi
HMMER_SHA256="ca70d94fd0cf271bd7063423aabb116d42de533117343a9b27a65c17ff06fbf3"
INSTALL="${ACTS_HMMER_PREFIX:-/project2/biyik_1165/jjt_373/csci270-star/diverse_genomes/hmmer-3.4-install}"

export PYTHONPATH="${ROOT}"
export PYTHONUNBUFFERED=1
export ACTS_CODE_ROOT="${ROOT}"
export ACTS_PFAM_OLD="${OLD_HMM}"
export ACTS_PFAM_NEW="${NEW_HMM}"
export ACTS_SCRATCH="${SCRATCH}"
export ACTS_HMMER_SHA256="${HMMER_SHA256}"

if [[ -f /etc/profile.d/modules.sh ]]; then source /etc/profile.d/modules.sh; fi
module purge 2>/dev/null || true
module load gcc/13.3.0 || module load gcc || true
module load python/3.11.9 || module load python || true

mkdir -p "${SCRATCH}" "${ROOT}/../results" "${ROOT}/../logs"
echo "=== host ==="
hostname
date -Is
nproc
python3 --version
echo "SCRATCH=${SCRATCH}"
df -h /tmp || true
df -h "${SCRATCH}" || true
grep -E 'MemTotal|MemAvailable' /proc/meminfo || true

echo "=== HMMER 3.4, built once under a lock ==="
mkdir -p "$(dirname "${INSTALL}")"
exec 9>"${INSTALL}.lock"
flock 9
if [[ ! -x "${INSTALL}/bin/hmmscan" ]]; then
  TARBALL=""
  for candidate in \
    "${ROOT}/hmmer-3.4.tar.gz" \
    /project2/biyik_1165/jjt_373/csci270-star/headline_exact/hmmer-3.4.tar.gz \
    /project2/biyik_1165/jjt_373/csci270-star/pipeline/builds/hmmer-3.4.tar.gz \
    /project2/biyik_1165/jjt_373/csci270-star/builds/hmmer-3.4.tar.gz
  do
    if [[ -f "${candidate}" ]]; then
      TARBALL="${candidate}"
      break
    fi
  done
  if [[ -z "${TARBALL}" ]]; then
    echo "STOP: HMMER 3.4 tarball is not on the project" >&2
    exit 2
  fi
  echo "tarball=${TARBALL}"
  sha256sum "${TARBALL}" | tee "${SCRATCH}/hmmer.sha256"
  got="$(awk '{print $1}' "${SCRATCH}/hmmer.sha256")"
  if [[ "${got}" != "${HMMER_SHA256}" ]]; then
    echo "STOP: HMMER tarball sha256 ${got} != ${HMMER_SHA256}" >&2
    exit 2
  fi
  rm -rf "${SCRATCH}/hmmer-3.4" "${INSTALL}"
  tar -C "${SCRATCH}" -xf "${TARBALL}"
  cd "${SCRATCH}/hmmer-3.4"
  ./configure --prefix="${INSTALL}"
  make -j"${SLURM_CPUS_PER_TASK:-8}"
  make install
  cd /
fi
flock -u 9
export PATH="${INSTALL}/bin:${PATH}"
hash -r
command -v hmmscan
hmmscan -h | head -n 3

python3 "${ROOT}/scripts/diverse_genomes_carc.py"
echo DIVERSE_GENOMES_TASK_DONE
