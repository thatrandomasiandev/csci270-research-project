#!/bin/bash
# Measured timing. Exclusive epyc-7542.
# Offline chain (2026-10-20): --time=12:00:00 (≥ 8 h HMMER-class floor; confirm
# wall was minutes; diamond measured arms need headroom without laptop resize).
# Guard: confirm.json must have confirmation_pass=true before timing starts.
#SBATCH --job-name=tare-w12b-measured
#SBATCH --account=biyik_1165
#SBATCH --partition=main
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=32
#SBATCH --exclusive
#SBATCH --mem=0
#SBATCH --constraint=epyc-7542
#SBATCH --time=12:00:00
#SBATCH --output=/scratch1/jjt_373/tare-w12b/logs/%x-%j.out
#SBATCH --error=/scratch1/jjt_373/tare-w12b/logs/%x-%j.err

set -euo pipefail

if [[ -f /etc/profile.d/modules.sh ]]; then
  # shellcheck disable=SC1091
  source /etc/profile.d/modules.sh
fi
module purge 2>/dev/null || true
module load python/3.11.9

ROOT=/project2/biyik_1165/jjt_373/csci270-star/tare-w12b
cd "${ROOT}"
mkdir -p /scratch1/jjt_373/tare-w12b/measured /scratch1/jjt_373/tare-w12b/logs \
  "${ROOT}/pipeline/results/iseqsearch_timing"

export PYTHONPATH="${ROOT}/pipeline"
export PYTHONUNBUFFERED=1
export OMP_NUM_THREADS=32
ACTS_GIT_HASH="$(tr -d '[:space:]' < "${ROOT}/pipeline/results/iseqsearch_timing/GIT_HASH")"
export ACTS_GIT_HASH
export TARE_DIAMOND=/project2/biyik_1165/jjt_373/csci270-star/pipeline-ref-second/bin/diamond
export TARE_OLD_FASTA=/project2/biyik_1165/jjt_373/csci270-star/pipeline-ref-second/data/swissprot/uniprot_sprot_2026_01.fasta.gz
export TARE_NEW_FASTA=/project2/biyik_1165/jjt_373/csci270-star/pipeline-ref-second/data/swissprot/uniprot_sprot_2026_03.fasta.gz
export TARE_QUERY_FAA=/project2/biyik_1165/jjt_373/csci270-star/pipeline/data/recurrence/A/GCF_002853805.1_protein.faa.gz
export TARE_ISEQ=/project2/biyik_1165/jjt_373/csci270-star/pipeline-ref-second/iseq/Incremental-Protein-Search
export TARE_SCRATCH=/scratch1/jjt_373/tare-w12b/measured
export TARE_OUT="${ROOT}/pipeline/results/iseqsearch_timing/measured.json"
export TARE_THREADS=32
export TARE_EXCLUSIVE=1

python3 - <<'PY'
import json, sys
from pathlib import Path
p = Path("pipeline/results/iseqsearch_timing/confirm.json")
if not p.is_file():
    sys.exit("STOP: confirm.json missing; measured stays unstarted")
d = json.loads(p.read_text())
if not d.get("confirmation_pass"):
    sys.exit(f"STOP: confirmation_pass={d.get('confirmation_pass')} why={d.get('why')!r}")
print("confirm PASS; starting measured", flush=True)
PY

python3 "${ROOT}/pipeline/scripts/iseqsearch_timing.py" measured
