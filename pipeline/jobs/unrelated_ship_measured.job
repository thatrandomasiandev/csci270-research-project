#!/bin/bash
# Measured correctness run. Submit only after UNRELATED_SHIP_PROTOCOL.md is in this tree.
#SBATCH --job-name=tare_a_meas
#SBATCH --account=biyik_1165
#SBATCH --partition=main
#SBATCH --constraint=epyc-7542
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=4
#SBATCH --mem=16G
#SBATCH --time=16:00:00
#SBATCH --output=/project2/biyik_1165/jjt_373/csci270-star/tare-exp-a/logs/%x-%j.out
#SBATCH --error=/project2/biyik_1165/jjt_373/csci270-star/tare-exp-a/logs/%x-%j.err

set -euo pipefail

PROJ=/project2/biyik_1165/jjt_373/csci270-star/tare-exp-a
if [[ -f /etc/profile.d/modules.sh ]]; then
  # shellcheck disable=SC1091
  source /etc/profile.d/modules.sh
fi
module purge
module load gcc/13.3.0
module load python/3.11.9

export ACTS_GIT_HASH
ACTS_GIT_HASH="$(tr -d '[:space:]' < "${PROJ}/GIT_HASH")"
export PYTHONPATH="${PROJ}/pipeline"
export PATH="${PROJ}/pfscan/bin:${PATH}"

cd "${PROJ}/pipeline"
test -f docs/UNRELATED_SHIP_PROTOCOL.md
grep -q "Power floor: 1906" docs/UNRELATED_SHIP_PROTOCOL.md
echo "git ${ACTS_GIT_HASH}"
echo "host $(hostname)"
python3 scripts/unrelated_ship.py measured
echo "measured_exit $?"
