#!/bin/bash
# Measured DIAMOND order run. Non-exclusive, 2 threads, correctness only.
#SBATCH --job-name=diamond_order_g1
#SBATCH --account=biyik_1165
#SBATCH --partition=main
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=2
#SBATCH --mem=8G
#SBATCH --time=04:00:00
#SBATCH --nice=10000
#SBATCH --output=/scratch1/jjt_373/tare_g_diamond_order/logs/%x-%j.out
#SBATCH --error=/scratch1/jjt_373/tare_g_diamond_order/logs/%x-%j.err

set -euo pipefail

ROOT=/scratch1/jjt_373/tare_g_diamond_order/code
cd "${ROOT}"
mkdir -p /scratch1/jjt_373/tare_g_diamond_order/work /scratch1/jjt_373/tare_g_diamond_order/logs

export TARE_DIAMOND=/project2/biyik_1165/jjt_373/csci270-star/pipeline-ref-second/bin/diamond
export TARE_SWISSPROT=/project2/biyik_1165/jjt_373/csci270-star/pipeline-ref-second/data/swissprot/uniprot_sprot_2026_03.fasta.gz
export TARE_GENOME=/project2/biyik_1165/jjt_373/csci270-star/pipeline/data/recurrence/A/GCF_001650275.1_protein.faa.gz
export TARE_SCRATCH=/scratch1/jjt_373/tare_g_diamond_order/work
export TARE_PILOT_JSON="${ROOT}/results/diamond_order/g1_pilot.json"
export TARE_QUERY_MD5=001d44c99ebe6a56ed7aa116648ffc92
export PYTHONUNBUFFERED=1

python3 scripts/diamond_order.py g1-measured
