#!/bin/bash
# Discriminating smoke: genome 1, genome 2, replay. Both HMMER modes.
# Ordinary shared xeon-4116 only. No exclusive. No epyc-7542.
#SBATCH --job-name=base_smoke
#SBATCH --account=biyik_1165
#SBATCH --partition=main
#SBATCH --constraint=xeon-4116
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=8
#SBATCH --mem=48G
#SBATCH --time=1-20:00:00
#SBATCH --output=/project2/biyik_1165/jjt_373/csci270-star/acts-baselines-20261009/logs/%x-%j.out
#SBATCH --error=/project2/biyik_1165/jjt_373/csci270-star/acts-baselines-20261009/logs/%x-%j.err

set -euo pipefail

ROOT=/project2/biyik_1165/jjt_373/csci270-star/acts-baselines-20261009
export ACTS_GIT_HASH_FILE="${ACTS_GIT_HASH_FILE:-${ROOT}/ACTS_GIT_HASH}"
export PYTHONPATH="${ROOT}/scripts"
TOOL="${ACTS_BASELINE_TOOL:?}"
COLUMN="${ACTS_BASELINE_COLUMN:?}"

case "${SLURM_JOB_CONSTRAINT:-}" in
  *epyc-7542*) echo "refusing epyc-7542" >&2; exit 2 ;;
esac

if [[ -f /etc/profile.d/modules.sh ]]; then source /etc/profile.d/modules.sh; fi
module load gcc/13.3.0 2>/dev/null || true
module load python/3.11.9 2>/dev/null || true

echo "=== smoke ${TOOL} ${COLUMN} job ${SLURM_JOB_ID:-} ==="
hostname
date -Is
nproc
lscpu | grep -E 'Model name|CPU\(s\)' || true
echo "CONSTRAINT=${SLURM_JOB_CONSTRAINT:-}"

MODES="${ACTS_BASELINE_MODES:-hmmsearch,hmmscan}"
OUT="${ACTS_BASELINE_OUT:-${ROOT}/results/baseline_smoke_${TOOL}_${COLUMN}.json}"
WORK_ARGS=()
if [[ -n "${ACTS_BASELINE_WORK:-}" ]]; then
  WORK_ARGS=(--work "${ACTS_BASELINE_WORK}")
fi
if [[ "${MODES}" == *hmmscan* ]]; then
  # Same HMMER 3.4 (Aug 2023) build as the smoke binaries. The build job
  # copied hmmscan and hmmsearch only. Copying hmmpress is untimed setup;
  # the harness records the press itself and does not put it in a step wall.
  export ACTS_HMMPRESS_SRC="${ACTS_HMMPRESS_SRC:-/project2/biyik_1165/jjt_373/csci270-star/acts-hmmsearch-stock-20261008/hmmer-3.4/bin/hmmpress}"
  echo "hmmpress source ${ACTS_HMMPRESS_SRC}"
fi
echo "MODES=${MODES}"
echo "OUT=${OUT}"

python3 "${ROOT}/scripts/baseline_smoke.py" \
  --root "${ROOT}" \
  --tool "${TOOL}" \
  --column "${COLUMN}" \
  --modes "${MODES}" \
  --build-json "${ROOT}/results/baseline_build.json" \
  --stock-dir /project2/biyik_1165/jjt_373/csci270-star/pipeline/results/savings/tblout \
  --out "${OUT}" \
  "${WORK_ARGS[@]}"

echo SMOKE_DONE
