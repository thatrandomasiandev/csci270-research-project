#!/bin/bash
# Exclusive-node HMMER headline screen (HEADLINE_SCREEN.md + 2026-09-26 erratum).
#SBATCH --job-name=acts_hmmer
#SBATCH --account=biyik_1165
#SBATCH --partition=main
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=32
#SBATCH --exclusive
#SBATCH --mem=64G
#SBATCH --time=08:00:00
#SBATCH --output=/project2/biyik_1165/jjt_373/csci270-star/pipeline/results/headline_hmmer-%j.out
#SBATCH --error=/project2/biyik_1165/jjt_373/csci270-star/pipeline/results/headline_hmmer-%j.err

set -euo pipefail

SRC=/project2/biyik_1165/jjt_373/csci270-star/pipeline
SCRATCH="${SLURM_TMPDIR:-${TMPDIR:-/tmp}}/acts_headline_${SLURM_JOB_ID}"
mkdir -p "${SRC}/results" "${SCRATCH}"/{bin,hmmer,work}

if [[ -f /etc/profile.d/modules.sh ]]; then source /etc/profile.d/modules.sh; fi
module purge 2>/dev/null || true
module load gcc/13.3.0 || module load gcc || true
module load python/3.11.9 || module load python || true
# Some CARC images ship HMMER; ignore if absent.
module load hmmer 2>/dev/null || module load hmmer/3.3.2 2>/dev/null || true

echo "=== host / cpu ==="
hostname
date -Is
uptime
nproc
python3 --version
lscpu | grep -E 'Model name|CPU\(s\)|Thread|MHz' || true
echo "SCRATCH=${SCRATCH}"

if ! command -v hmmsearch >/dev/null 2>&1; then
  echo "=== build HMMER 3.4 on the compute node ==="
  cd "${SCRATCH}"
  curl -L --fail -o hmmer-3.4.tar.gz http://eddylab.org/software/hmmer/hmmer-3.4.tar.gz
  tar xf hmmer-3.4.tar.gz
  cd hmmer-3.4
  ./configure --prefix="${SCRATCH}"
  make -j"${SLURM_CPUS_PER_TASK:-8}"
  make install
  export PATH="${SCRATCH}/bin:${PATH}"
fi
command -v hmmsearch
hmmsearch -h | head -n 3

echo "=== stage inputs to node-local scratch ==="
mkdir -p "${SCRATCH}/pipeline"/{scripts,results,data/kprot,data/hmmer}
cp "${SRC}/scripts/run_headline_screen.py" "${SCRATCH}/pipeline/scripts/"
cp "${SRC}/results/kprot_overlap.json" "${SCRATCH}/pipeline/results/"
cp "${SRC}/data/kprot/BW25113.faa.gz" "${SCRATCH}/pipeline/data/kprot/"
if [[ -f "${SRC}/data/hmmer/Pfam-A.hmm.gz" ]]; then
  cp "${SRC}/data/hmmer/Pfam-A.hmm.gz" "${SCRATCH}/pipeline/data/hmmer/"
elif [[ -f "${SRC}/data/hmmer/Pfam-A.hmm" ]]; then
  cp "${SRC}/data/hmmer/Pfam-A.hmm" "${SCRATCH}/pipeline/data/hmmer/"
else
  echo "=== fetch Pfam-A (399 MB) on the compute node ==="
  curl -L --fail --retry 3 -o "${SCRATCH}/pipeline/data/hmmer/Pfam-A.hmm.gz" \
    https://ftp.ebi.ac.uk/pub/databases/Pfam/current_release/Pfam-A.hmm.gz
  curl -L --fail --retry 3 -o "${SCRATCH}/pipeline/data/hmmer/Pfam.version.gz" \
    https://ftp.ebi.ac.uk/pub/databases/Pfam/current_release/Pfam.version.gz || true
fi
if [[ -f "${SRC}/data/hmmer/Pfam.version.gz" ]]; then
  cp "${SRC}/data/hmmer/Pfam.version.gz" "${SCRATCH}/pipeline/data/hmmer/"
fi

export PATH
export ACTS_PIPELINE_ROOT="${SCRATCH}/pipeline"
export ACTS_HEADLINE_WORK="${SCRATCH}/work"
export ACTS_HEADLINE_OUT="${SCRATCH}/headline_screen.json"
export ACTS_FAA="${SCRATCH}/pipeline/data/kprot/BW25113.faa.gz"
if [[ -f "${SCRATCH}/pipeline/data/hmmer/Pfam-A.hmm" ]]; then
  export ACTS_PFAM="${SCRATCH}/pipeline/data/hmmer/Pfam-A.hmm"
else
  export ACTS_PFAM="${SCRATCH}/pipeline/data/hmmer/Pfam-A.hmm.gz"
fi
export PYTHONPATH="${SCRATCH}/pipeline"

echo "=== run ==="
python3 "${SCRATCH}/pipeline/scripts/run_headline_screen.py"

cp "${ACTS_HEADLINE_OUT}" "${SRC}/results/headline_screen.json"
echo "copied result to ${SRC}/results/headline_screen.json"
echo HEADLINE_HMMER_DONE
