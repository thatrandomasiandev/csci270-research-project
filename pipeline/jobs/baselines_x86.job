#!/bin/bash
# Table 4 on one exclusive EPYC 7542. Name must start with tare-w5x.
# Pilot and measured share this file; sbatch sets the job name and the time limit.
#SBATCH --job-name=tare-w5x-pilot
#SBATCH --account=biyik_1165
#SBATCH --partition=main
#SBATCH --constraint=epyc-7542
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=32
#SBATCH --exclusive
#SBATCH --mem=0
#SBATCH --time=03:00:00
#SBATCH --output=/project2/biyik_1165/jjt_373/csci270-star/tare-w5x/logs/%x-%j.out
#SBATCH --error=/project2/biyik_1165/jjt_373/csci270-star/tare-w5x/logs/%x-%j.err

set -u

if [[ -z "${SLURM_JOB_ID:-}" ]]; then
  echo "refusing to run outside SLURM" >&2
  exit 2
fi

ulimit -n 65536 || true

ROOT=/project2/biyik_1165/jjt_373/csci270-star/tare-w5x
SCRATCH=/scratch1/${USER}/tare-w5x/${SLURM_JOB_ID}
PHASE="${ACTS_PHASE:?set ACTS_PHASE to pilot or measured}"
OUT="${ROOT}/results/${PHASE}.json"

mkdir -p "${ROOT}/logs" "${ROOT}/results" "${SCRATCH}"
if [[ -f /etc/profile.d/modules.sh ]]; then
  source /etc/profile.d/modules.sh
fi
module load gcc/13.3.0 || true
module load python/3.11.9 || true
module load util-linux/2.40 || true

python3 -c 'import sys; assert sys.version_info[:2] >= (3, 11), sys.version'
unshare --version | head -n 1

export PYTHONPATH="${ROOT}/pipeline"
export PYTHONUNBUFFERED=1
export ACTS_GIT_HEAD
ACTS_GIT_HEAD="$(tr -d '[:space:]' < "${ROOT}/GIT_HEAD")"
export ACTS_EXCLUSIVE=1
export OMP_NUM_THREADS=1

cd "${ROOT}/pipeline"
exec python3 "${ROOT}/pipeline/scripts/baselines_x86.py" \
  --phase "${PHASE}" \
  --scratch "${SCRATCH}" \
  --out "${OUT}" \
  --protocol "${ROOT}/pipeline/docs/BASELINES_X86_PROTOCOL.md"
