#!/bin/bash
# Exclusive-node DIAMOND second-tool run. Not a savings job.
# Submit with absolute --output and --error under this code tree.
#SBATCH --job-name=acts_ref_diamond
#SBATCH --account=biyik_1165
#SBATCH --partition=main
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=32
#SBATCH --exclusive
#SBATCH --mem=0
#SBATCH --constraint=epyc-7542
#SBATCH --time=24:00:00
#SBATCH --output=diamond-%j.out
#SBATCH --error=diamond-%j.err

set -euo pipefail

ROOT="${ACTS_CODE_ROOT:?STOP_INPUTS: ACTS_CODE_ROOT is unset}"
case "${ROOT}" in
  /*) ;;
  *)
    echo "STOP_INPUTS: ACTS_CODE_ROOT is not an absolute path: ${ROOT}" >&2
    exit 2
    ;;
esac
cd "${ROOT}"

# shellcheck source=../scripts/absolute_inputs.sh
source "${ROOT}/pipeline/scripts/absolute_inputs.sh"

PIPE="${ROOT}/pipeline"
OUT="${ROOT}/results/reference_diamond"
# /tmp on CARC compute nodes is tmpfs. Those bytes count against the job
# memory cgroup. D3 scratch is the Lustre scratch filesystem.
SCRATCH_PARENT="/scratch1/${USER}"
if [[ ! -d "${SCRATCH_PARENT}" ]]; then
  echo "STOP_SCRATCH: ${SCRATCH_PARENT} is not a directory" >&2
  exit 2
fi
WORK="${SCRATCH_PARENT}/acts_ref_diamond_${SLURM_JOB_ID:?}"
mkdir -p "${OUT}" "${WORK}"
FSTYPE="$(findmnt -n -o FSTYPE -T "${WORK}" || true)"
echo "WORK=${WORK} FSTYPE=${FSTYPE}"
if [[ -z "${FSTYPE}" || "${FSTYPE}" == "tmpfs" ]]; then
  echo "STOP_SCRATCH: D3 scratch ${WORK} fstype '${FSTYPE}' is not a disk" >&2
  exit 2
fi

PY="${ROOT}/venv/bin/python"
if [[ ! -x "${PY}" ]]; then
  echo "STOP_INPUTS: pinned venv is missing at ${ROOT}/venv" >&2
  exit 2
fi

if [[ -f /etc/profile.d/modules.sh ]]; then source /etc/profile.d/modules.sh; fi
module purge 2>/dev/null || true
module load python/3.11.9 || module load python || true

export TMPDIR="${WORK}"
export PYTHONPATH="${PIPE}"
export ACTS_GIT_HASH_FILE="${ACTS_GIT_HASH_FILE:-${OUT}/GIT_HASH}"
if [[ -n "${ACTS_GIT_HASH:-}" ]]; then
  printf '%s\n' "${ACTS_GIT_HASH}" > "${ACTS_GIT_HASH_FILE}"
fi

OLD="$(require_absolute old "${ACTS_OLD_FASTA:?STOP_INPUTS: ACTS_OLD_FASTA is unset}")"
NEW="$(require_absolute new "${ACTS_NEW_FASTA:?STOP_INPUTS: ACTS_NEW_FASTA is unset}")"
QUERIES="$(require_absolute queries "${ACTS_QUERIES:?STOP_INPUTS: ACTS_QUERIES is unset}")"
DIAMOND="$(require_absolute diamond "${ACTS_DIAMOND:?STOP_INPUTS: ACTS_DIAMOND is unset}")"
ISEQ="$(require_absolute iseq "${ACTS_ISEQ:?STOP_INPUTS: ACTS_ISEQ is unset}")"

echo "=== host ==="
hostname
date -Is
lscpu | grep -E 'Model name|CPU\(s\)' || true
"${PY}" --version
"${DIAMOND}" version
echo "ROOT=${ROOT}"
echo "OLD=${OLD}"
echo "NEW=${NEW}"
echo "QUERIES=${QUERIES}"
echo "DIAMOND=${DIAMOND}"
echo "ISEQ=${ISEQ}"
df -h "${WORK}" "${ROOT}" || true

set +e
"${PY}" "${PIPE}/scripts/run_reference_diamond.py" \
  --root "${ROOT}" \
  --diamond "${DIAMOND}" \
  --old "${OLD}" \
  --new "${NEW}" \
  --queries "${QUERIES}" \
  --iseq "${ISEQ}" \
  --out "${OUT}" \
  --work "${WORK}" \
  --resume-d3
status=$?
set -e
if [[ "${status}" -eq 0 ]]; then
  rm -rf "${WORK}"
  echo REF_DIAMOND_DONE
else
  echo "leaving scratch ${WORK} after exit ${status}"
fi
exit "${status}"
