#!/bin/bash
# TARE W6 follow-up. One refused HMMER genome per array task. Non-exclusive.
# Not a timing run. Scratch is /scratch1, never node /tmp.
#SBATCH --job-name=tare-w6-hmmer
#SBATCH --account=biyik_1165
#SBATCH --partition=main
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=8
#SBATCH --mem=16G
#SBATCH --time=06:00:00
#SBATCH --array=0-3
#SBATCH --output=/project2/biyik_1165/jjt_373/csci270-star/tare-w6/logs/%x-%A_%a.out
#SBATCH --error=/project2/biyik_1165/jjt_373/csci270-star/tare-w6/logs/%x-%A_%a.err

set -euo pipefail

ROOT=/project2/biyik_1165/jjt_373/csci270-star/tare-w6
PIPE="${ROOT}/pipeline"
OLD_HMM=/project2/biyik_1165/jjt_373/csci270-star/reference_reannot/data/pfam38.1/Pfam-A.hmm.gz
NEW_HMM=/project2/biyik_1165/jjt_373/csci270-star/pipeline/data/hmmer/Pfam-A.hmm.gz
DIVERSE=/project2/biyik_1165/jjt_373/csci270-star/diverse_genomes/proteomes
HEADLINE=/project2/biyik_1165/jjt_373/csci270-star/pipeline/data/recurrence/A
INSTALL=/project2/biyik_1165/jjt_373/csci270-star/diverse_genomes/hmmer-3.4-install
SCRATCH="/scratch1/${USER}/tare-w6/hmmer_${SLURM_ARRAY_JOB_ID}_${SLURM_ARRAY_TASK_ID}"

case "${SLURM_ARRAY_TASK_ID}" in
  0) ACC=GCF_002078355.1; QUERIES="${DIVERSE}/${ACC}_protein.faa.gz" ;;
  1) ACC=GCF_000284335.1; QUERIES="${DIVERSE}/${ACC}_protein.faa.gz" ;;
  2) ACC=GCF_001017655.1; QUERIES="${DIVERSE}/${ACC}_protein.faa.gz" ;;
  3) ACC=GCA_001817145.1; QUERIES="${DIVERSE}/${ACC}_protein.faa.gz" ;;
  *) echo "STOP: task ${SLURM_ARRAY_TASK_ID} is not in the small array" >&2; exit 2 ;;
esac
case "${QUERIES}" in /*) ;; *) echo "QUERIES must be an absolute path: ${QUERIES}" >&2; exit 2 ;; esac

export PYTHONPATH="${PIPE}"
export PYTHONUNBUFFERED=1
export ACTS_COMMIT
ACTS_COMMIT="$(tr -d '[:space:]' < "${ROOT}/ACTS_COMMIT")"
export ACTS_GIT_HEAD="${ACTS_COMMIT}"
export ACTS_GIT_HASH="${ACTS_COMMIT}"
export ACTS_HMMER_SHA256=ca70d94fd0cf271bd7063423aabb116d42de533117343a9b27a65c17ff06fbf3
export PATH="${INSTALL}/bin:${PATH}"

if [[ -f /etc/profile.d/modules.sh ]]; then source /etc/profile.d/modules.sh; fi
module purge 2>/dev/null || true
module load gcc/13.3.0 || true
module load python/3.11.9

mkdir -p "${SCRATCH}" "${ROOT}/logs" "${ROOT}/results"
echo "=== tare-w6 hmmer ${ACC} ==="
hostname
date -Is
command -v hmmscan
hmmscan -h | head -n 3

python3 "${PIPE}/scripts/w6_hmmer_followup.py" \
  --accession "${ACC}" \
  --queries "${QUERIES}" \
  --old-hmm "${OLD_HMM}" \
  --new-hmm "${NEW_HMM}" \
  --scratch "${SCRATCH}" \
  --out "${ROOT}/results/hmmer_${ACC}.json"

rm -rf "${SCRATCH}"
echo TARE_W6_HMMER_DONE
