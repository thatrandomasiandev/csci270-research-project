#!/bin/bash
# TARE W6 follow-up for the headline genome that refused at cache fill.
# Non-exclusive. hmmscan --cpu 4, the argv of job 13208152 task 3.
# Original stock 3072 s and fill 3018 s. Limit covers a second full scan plus 50%.
#SBATCH --job-name=tare-w6-hmmer
#SBATCH --account=biyik_1165
#SBATCH --partition=main
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=4
#SBATCH --mem=32G
#SBATCH --time=08:00:00
#SBATCH --output=/project2/biyik_1165/jjt_373/csci270-star/tare-w6/logs/%x-%j.out
#SBATCH --error=/project2/biyik_1165/jjt_373/csci270-star/tare-w6/logs/%x-%j.err

set -euo pipefail

ROOT=/project2/biyik_1165/jjt_373/csci270-star/tare-w6
PIPE="${ROOT}/pipeline"
ACC=GCF_015290725.1
OLD_HMM=/project2/biyik_1165/jjt_373/csci270-star/reference_reannot/data/pfam38.1/Pfam-A.hmm.gz
NEW_HMM=/project2/biyik_1165/jjt_373/csci270-star/pipeline/data/hmmer/Pfam-A.hmm.gz
QUERIES=/project2/biyik_1165/jjt_373/csci270-star/pipeline/data/recurrence/A/${ACC}_protein.faa.gz
INSTALL=/project2/biyik_1165/jjt_373/csci270-star/diverse_genomes/hmmer-3.4-install
SCRATCH="/scratch1/${USER}/tare-w6/hmmer_${SLURM_JOB_ID}_headline"

export PYTHONPATH="${PIPE}"
export PYTHONUNBUFFERED=1
export ACTS_COMMIT
ACTS_COMMIT="$(tr -d '[:space:]' < "${ROOT}/ACTS_COMMIT")"
export ACTS_GIT_HEAD="${ACTS_COMMIT}"
export ACTS_GIT_HASH="${ACTS_COMMIT}"
export ACTS_HMMER_SHA256=ca70d94fd0cf271bd7063423aabb116d42de533117343a9b27a65c17ff06fbf3
export PATH="${INSTALL}/bin:${PATH}"

if [[ -f /etc/profile.d/modules.sh ]]; then source /etc/profile.d/modules.sh; fi
module purge 2>/dev/null || true
module load gcc/13.3.0 || true
module load python/3.11.9

mkdir -p "${SCRATCH}" "${ROOT}/logs" "${ROOT}/results"
echo "=== tare-w6 hmmer ${ACC} ==="
hostname
date -Is
command -v hmmscan
hmmscan -h | head -n 3

python3 "${PIPE}/scripts/w6_hmmer_followup.py" \
  --accession "${ACC}" \
  --queries "${QUERIES}" \
  --old-hmm "${OLD_HMM}" \
  --new-hmm "${NEW_HMM}" \
  --scratch "${SCRATCH}" \
  --out "${ROOT}/results/hmmer_${ACC}.json"

rm -rf "${SCRATCH}"
echo TARE_W6_HMMER_DONE
