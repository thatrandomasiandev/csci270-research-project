#!/bin/bash
# TARE experiment E: BLAST+ pin exactness pilot.
# Pre-registered in pipeline/docs/BLAST_PIN_PROTOCOL.md.
# Not a timing run. Ordinary shared node.
# Do not add --exclusive. Do not touch jobs 12864756 or 13208152.
#SBATCH --job-name=tare_e_pin
#SBATCH --account=biyik_1165
#SBATCH --partition=main
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=4
#SBATCH --mem=32G
#SBATCH --time=03:00:00
#SBATCH --output=/project2/biyik_1165/jjt_373/csci270-star/tare-exp-e/logs/%x-%j.out
#SBATCH --error=/project2/biyik_1165/jjt_373/csci270-star/tare-exp-e/logs/%x-%j.err

set -euo pipefail

ROOT=/project2/biyik_1165/jjt_373/csci270-star/tare-exp-e
PIPE="${ROOT}/pipeline"
DATA=/project2/biyik_1165/jjt_373/csci270-star/pipeline-ref-second/data/swissprot
QUERIES=/project2/biyik_1165/jjt_373/csci270-star/pipeline/data/recurrence/A/GCF_001513615.1_protein.faa.gz
OUT="${ROOT}/results/pin_pilot.json"
WORK=/scratch1/jjt_373/tare_e/blast_pin_pilot

mkdir -p "${ROOT}/logs" "${ROOT}/results" "${WORK}"

if [[ -f /etc/profile.d/modules.sh ]]; then source /etc/profile.d/modules.sh; fi
module purge 2>/dev/null || true
module load gcc/13.3.0 || true
module load python/3.11.9
module load blast-plus/2.14.1

export PYTHONPATH="${PIPE}"
export ACTS_GIT_HASH_FILE="${ROOT}/GIT_HASH"
export OMP_NUM_THREADS=2
export OPENBLAS_NUM_THREADS=1
export MKL_NUM_THREADS=1
unset OLD_FSC || true

echo "=== TARE BLAST pin pilot ==="
hostname
date -Is
command -v blastp
blastp -version
echo "GIT_HASH=$(tr -d '[:space:]' < "${ACTS_GIT_HASH_FILE}")"

nice -n 10 python3 "${PIPE}/scripts/blast_pin_pilot.py" \
  --queries-src "${QUERIES}" \
  --release-old "${DATA}/uniprot_sprot_2026_01.fasta.gz" \
  --release-new "${DATA}/uniprot_sprot_2026_03.fasta.gz" \
  --blastp "$(command -v blastp)" \
  --makeblastdb "$(command -v makeblastdb)" \
  --work "${WORK}" \
  --out "${OUT}" \
  --pipe "${PIPE}"

rm -rf "${WORK}/db" "${WORK}/new.faa" "${WORK}/candidates.faa" "${WORK}/candidates_drop.faa"
echo BLAST_PIN_PILOT_DONE
