#!/bin/bash
# B1 reference-boundary fit. Correctness only. Not a timing run.
# Ordinary shared node. Do not add --exclusive or --constraint=epyc-7542.
# Stage with rsync through discovery, then:
#   ssh discovery sbatch /project2/biyik_1165/jjt_373/csci270-star/acts-reference-boundary-20261009/pipeline/jobs/reference_boundary.job
#SBATCH --job-name=acts_ref_boundary
#SBATCH --account=biyik_1165
#SBATCH --partition=main
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=4
#SBATCH --mem=16G
#SBATCH --time=12:00:00
#SBATCH --output=/project2/biyik_1165/jjt_373/csci270-star/acts-reference-boundary-20261009/logs/%x-%j.out
#SBATCH --error=/project2/biyik_1165/jjt_373/csci270-star/acts-reference-boundary-20261009/logs/%x-%j.err

set -euo pipefail

ROOT=/project2/biyik_1165/jjt_373/csci270-star/acts-reference-boundary-20261009
PIPE="${ROOT}/pipeline"
REF=/project2/biyik_1165/jjt_373/csci270-star/pipeline-ref-second/data/swissprot/uniprot_sprot_2026_03.fasta.gz
QUERIES=/project2/biyik_1165/jjt_373/csci270-star/pipeline-ref-second/pipeline/data/recurrence/A/GCF_002853805.1_protein.faa.gz
OUT="${ROOT}/results/reference_boundary_blast.json"
WORK="${SLURM_TMPDIR:-/tmp}/acts_ref_boundary_${SLURM_JOB_ID}"

mkdir -p "${ROOT}/logs" "${ROOT}/results" "${WORK}"

if [[ -f /etc/profile.d/modules.sh ]]; then source /etc/profile.d/modules.sh; fi
module purge 2>/dev/null || true
module load gcc/13.3.0 || true
module load python/3.11.9
module load blast-plus/2.14.1

export PYTHONPATH="${PIPE}"
export ACTS_GIT_HASH_FILE="${ROOT}/GIT_HASH"
export OMP_NUM_THREADS=4
unset OLD_FSC || true

echo "=== reference boundary host (not a timing run) ==="
hostname
date -Is
python3 --version
command -v blastp
command -v makeblastdb
blastp -version
echo "ROOT=${ROOT}"
echo "REF=${REF}"
echo "QUERIES=${QUERIES}"
echo "WORK=${WORK}"
if [[ -f "${ACTS_GIT_HASH_FILE}" ]]; then
  echo "GIT_HASH=$(tr -d '[:space:]' < "${ACTS_GIT_HASH_FILE}")"
fi

python3 "${PIPE}/scripts/run_reference_boundary.py" \
  --reference "${REF}" \
  --queries "${QUERIES}" \
  --blastp "$(command -v blastp)" \
  --makeblastdb "$(command -v makeblastdb)" \
  --out "${OUT}" \
  --work "${WORK}" \
  --threads 4

echo REF_BOUNDARY_DONE
