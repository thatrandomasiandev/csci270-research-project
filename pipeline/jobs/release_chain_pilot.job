#!/bin/bash
# TARE W8 release-chain pilot. One proteome, non-exclusive, EPYC 7542.
# Scratch is /scratch1. Node /tmp is not used (a prior tmpfs copy OOM'd).
# HMMER comes from the pinned tarball already on the project. No download.
# A crash in the runner writes a partial JSON and exits 2.
#SBATCH --job-name=tare-w8-pilot
#SBATCH --account=biyik_1165
#SBATCH --partition=main
#SBATCH --constraint=epyc-7542
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=8
#SBATCH --mem=64G
#SBATCH --time=16:00:00
#SBATCH --output=/project2/biyik_1165/jjt_373/csci270-star/tare-w8/logs/%x-%j.out
#SBATCH --error=/project2/biyik_1165/jjt_373/csci270-star/tare-w8/logs/%x-%j.err

set -euo pipefail

ROOT="${ACTS_CODE_ROOT:-/project2/biyik_1165/jjt_373/csci270-star/tare-w8}"
GENOMES="${ACTS_GENOMES:-/project2/biyik_1165/jjt_373/csci270-star/pipeline/data/recurrence/A}"
DATA="${ACTS_RELEASE_DIR:-/scratch1/${USER}/tare-w8/data}"
SCRATCH="/scratch1/${USER}/tare-w8/work/pilot_${SLURM_JOB_ID}"
HMMER_SHA256="ca70d94fd0cf271bd7063423aabb116d42de533117343a9b27a65c17ff06fbf3"

export PYTHONPATH="${ROOT}:${ROOT}/scripts"
export PYTHONUNBUFFERED=1
export ACTS_CODE_ROOT="${ROOT}"
export ACTS_GENOMES="${GENOMES}"
export ACTS_RELEASE_DIR="${DATA}"
export ACTS_DIVERSE_DRAW="${ROOT}/diverse_draw.json"
export ACTS_PAIRS="${ROOT}/pairs.json"
export ACTS_SCRATCH="${SCRATCH}"
export ACTS_OUT="${ROOT}/results/pilot_20261221.json"
export ACTS_MODE="pilot"
export ACTS_GIT_HEAD="${ACTS_GIT_HEAD:-}"
export ACTS_GIT_DIRTY="${ACTS_GIT_DIRTY:-}"
export ACTS_HMMER_SHA256="${HMMER_SHA256}"
export OMP_NUM_THREADS=1

if [[ -f /etc/profile.d/modules.sh ]]; then source /etc/profile.d/modules.sh; fi
module purge 2>/dev/null || true
module load gcc/13.3.0 || module load gcc || true
module load python/3.11.9 || module load python || true

mkdir -p "${SCRATCH}" "${ROOT}/results" "${ROOT}/logs"
echo "=== host ==="
hostname
date -Is
nproc
python3 --version
lscpu | grep -E 'Model name|CPU\(s\)' || true
echo "SCRATCH=${SCRATCH}"
echo "DATA=${DATA}"
df -h "${SCRATCH}" || true
df -h "${DATA}" || true
grep -E 'MemTotal|MemAvailable' /proc/meminfo || true
module list 2>&1 || true
gcc --version | head -n 1 || true

echo "=== HMMER 3.4 from the pinned tarball already on the project ==="
TARBALL=""
for candidate in \
  /project2/biyik_1165/jjt_373/csci270-star/headline_exact/hmmer-3.4.tar.gz \
  "${ROOT}/hmmer-3.4.tar.gz" \
  /project2/biyik_1165/jjt_373/csci270-star/pipeline/builds/hmmer-3.4.tar.gz \
  /project2/biyik_1165/jjt_373/csci270-star/builds/hmmer-3.4.tar.gz
do
  if [[ -f "${candidate}" ]]; then
    TARBALL="${candidate}"
    break
  fi
done
if [[ -z "${TARBALL}" ]]; then
  echo "STOP: pinned HMMER tarball is not on the project; not downloading" >&2
  exit 2
fi
echo "tarball=${TARBALL}"
sha256sum "${TARBALL}" | tee "${SCRATCH}/hmmer.sha256"
got="$(awk '{print $1}' "${SCRATCH}/hmmer.sha256")"
if [[ "${got}" != "${HMMER_SHA256}" ]]; then
  echo "STOP: HMMER tarball sha256 ${got} != ${HMMER_SHA256}" >&2
  exit 2
fi
tar -C "${SCRATCH}" -xf "${TARBALL}"
cd "${SCRATCH}/hmmer-3.4"
./configure --prefix="${SCRATCH}/hmmer"
make -j"${SLURM_CPUS_PER_TASK:-8}"
make install
export PATH="${SCRATCH}/hmmer/bin:${PATH}"
command -v hmmscan
hmmscan -h | head -n 3 || true

python3 "${ROOT}/scripts/release_chain_carc.py"
echo RELEASE_CHAIN_PILOT_DONE
