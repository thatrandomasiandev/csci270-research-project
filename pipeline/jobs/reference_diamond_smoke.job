#!/bin/bash
# Smoke of the DIAMOND driver. Not a measurement. Not exclusive.
# Submit with absolute --output and --error under reference_diamond_smoke/.
#SBATCH --job-name=acts_ref_diamond_smoke
#SBATCH --account=biyik_1165
#SBATCH --partition=main
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=4
#SBATCH --mem=16G
#SBATCH --time=02:00:00
#SBATCH --output=diamond-smoke-%j.out
#SBATCH --error=diamond-smoke-%j.err

set -euo pipefail

ROOT="${ACTS_CODE_ROOT:?STOP_INPUTS: ACTS_CODE_ROOT is unset}"
case "${ROOT}" in
  /*) ;;
  *)
    echo "STOP_INPUTS: ACTS_CODE_ROOT is not an absolute path: ${ROOT}" >&2
    exit 2
    ;;
esac
cd "${ROOT}"

# shellcheck source=../scripts/absolute_inputs.sh
source "${ROOT}/pipeline/scripts/absolute_inputs.sh"

PIPE="${ROOT}/pipeline"
OUT="${ROOT}/results/reference_diamond_smoke"
WORK="${SLURM_TMPDIR:-/tmp}/acts_ref_diamond_smoke_${SLURM_JOB_ID:-local}"
mkdir -p "${OUT}" "${WORK}"

# The venv is built on this compute node. The transfer host is not used.
bash "${ROOT}/pipeline/scripts/create_diamond_venv.sh" "${ROOT}"
PY="${ROOT}/venv/bin/python"
if [[ ! -x "${PY}" ]]; then
  echo "STOP_INPUTS: pinned venv is missing at ${ROOT}/venv" >&2
  exit 2
fi

if [[ -f /etc/profile.d/modules.sh ]]; then source /etc/profile.d/modules.sh; fi
module purge 2>/dev/null || true
module load python/3.11.9 || module load python || true

export TMPDIR="${WORK}"
export PYTHONPATH="${PIPE}"
export ACTS_GIT_HASH_FILE="${ACTS_GIT_HASH_FILE:-${OUT}/GIT_HASH}"
if [[ -n "${ACTS_GIT_HASH:-}" ]]; then
  printf '%s\n' "${ACTS_GIT_HASH}" > "${ACTS_GIT_HASH_FILE}"
fi

OLD="$(require_absolute old "${ACTS_OLD_FASTA:?STOP_INPUTS: ACTS_OLD_FASTA is unset}")"
NEW="$(require_absolute new "${ACTS_NEW_FASTA:?STOP_INPUTS: ACTS_NEW_FASTA is unset}")"
QUERIES="$(require_absolute queries "${ACTS_QUERIES:?STOP_INPUTS: ACTS_QUERIES is unset}")"
DIAMOND="$(require_absolute diamond "${ACTS_DIAMOND:?STOP_INPUTS: ACTS_DIAMOND is unset}")"
ISEQ="$(require_absolute iseq "${ACTS_ISEQ:?STOP_INPUTS: ACTS_ISEQ is unset}")"

echo "=== smoke host (not a measurement) ==="
hostname
date -Is
"${PY}" --version
echo "ROOT=${ROOT}"
echo "OLD=${OLD}"
echo "NEW=${NEW}"
echo "QUERIES=${QUERIES}"
echo "DIAMOND=${DIAMOND}"
echo "ISEQ=${ISEQ}"

"${PY}" "${PIPE}/scripts/run_reference_diamond.py" \
  --root "${ROOT}" \
  --diamond "${DIAMOND}" \
  --old "${OLD}" \
  --new "${NEW}" \
  --queries "${QUERIES}" \
  --iseq "${ISEQ}" \
  --out "${OUT}" \
  --work "${WORK}" \
  --smoke

echo REF_DIAMOND_SMOKE_DONE
